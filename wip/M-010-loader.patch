+// Loader capture: three.js is held (never answered) so the page stays in its loader with an idle
+// main thread; boot() otherwise blocks the screenshot pipeline for tens of seconds on software GL.
+async function loaderShots(p, times, errors) {
+  const t0 = Date.now();
+  await p.goto('file://' + page, { waitUntil: 'commit' });
+  const shots = [];
+  for (const t of times) {
+    const left = t - (Date.now() - t0);
+    if (left > 0) await p.waitForTimeout(left);
+    const f = out.replace(/\.png$/i, '') + '-' + t + '.png';
+    const at = Date.now() - t0;
+    // State is read right before the screenshot; a DPR-3 capture can itself take a second or more.
+    const state = await p.evaluate(() => {
+      const l = document.getElementById('loader');
+      const era = [...document.querySelectorAll('.ld-era span')].map(s => [s.textContent, +(+getComputedStyle(s).opacity).toFixed(2)]);
+      return { loaderClass: l ? l.className : null, era, caption: (document.getElementById('loadMsg') || {}).textContent };
+    }).catch(e => ({ error: e.message }));
+    await p.screenshot({ path: f, timeout: +(flags.shotTimeout || 180000) });
+    shots.push(Object.assign({ out: f, requestedMs: t, takenMs: at, doneMs: Date.now() - t0 }, state));
+  }
+  return shots;
+}
